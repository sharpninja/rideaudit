<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RideAudit.Client.Contracts</RootNamespace>
    <Description>Interim gRPC client stubs isolated from UI. GPL-2.0-or-later.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RideAudit.Client.Core\RideAudit.Client.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="interim\rideaudit\v1\custody.proto" GrpcServices="Client" />
  </ItemGroup>
</Project>
