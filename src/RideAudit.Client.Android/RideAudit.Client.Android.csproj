<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>org.rideaudit.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <Description>Avalonia UI 12 Android dual-phone capture client. GPL-2.0-or-later. Not a Play Store release.</Description>
  </PropertyGroup>
  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RideAudit.Shared.Ui\RideAudit.Shared.Ui.csproj" />
    <ProjectReference Include="..\RideAudit.Capture\RideAudit.Capture.csproj" />
    <ProjectReference Include="..\RideAudit.PlayIntegrity\RideAudit.PlayIntegrity.csproj" />
    <ProjectReference Include="..\RideAudit.Client.Contracts\RideAudit.Client.Contracts.csproj" />
    <ProjectReference Include="..\RideAudit.Video\RideAudit.Video.csproj" />
    <ProjectReference Include="..\RideAudit.Bt\RideAudit.Bt.csproj" />
  </ItemGroup>
</Project>
