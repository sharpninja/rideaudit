<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RideAudit.Shared.Ui.Views.MainView"
             FontSize="{StaticResource RideAuditBodyFontSize}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="12" Background="#111827">
      <StackPanel Orientation="Vertical" Spacing="4">
        <TextBlock x:Name="TitleText" Text="RideAudit" FontSize="{StaticResource RideAuditTitleFontSize}" />
        <TextBlock x:Name="LicenseNotice" />
        <TextBlock x:Name="FrameworkNotice" />
      </StackPanel>
    </Border>
    <ContentControl x:Name="Body" Margin="12" />
  </DockPanel>
</UserControl>
