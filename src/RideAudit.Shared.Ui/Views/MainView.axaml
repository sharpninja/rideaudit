<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RideAudit.Shared.Ui.Views.MainView"
             Background="#F4F7FA"
             FontSize="{StaticResource RideAuditBodyFontSize}">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" IsVisible="False">
      <TextBlock x:Name="TitleText" Text="RideAudit" FontSize="{StaticResource RideAuditTitleFontSize}" />
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#D5DEE8" BorderThickness="0,1,0,0" Padding="16,12">
      <Button x:Name="AboutButton" Content="About" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="48" />
    </Border>
    <ContentControl x:Name="Body" />
  </DockPanel>
</UserControl>
