<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RideAudit.Shared.Ui.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <x:Double x:Key="RideAuditBodyFontSize">28</x:Double>
    <x:Double x:Key="RideAuditTitleFontSize">36</x:Double>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource RideAuditBodyFontSize}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="{StaticResource RideAuditBodyFontSize}" />
    </Style>
  </Application.Styles>
</Application>
