# Copy to deploy/omarchy/.env on PAYTON-OMARCHY. Production refuses fixture flags.
# Unset calendars fail closed and admit nothing. Do not invent txids or Play JWTs.

RIDEAUDIT_EDGE_TLS=true
RIDEAUDIT_OTS_CALENDAR=
RIDEAUDIT_L2_CALENDAR=
RIDEAUDIT_L2_RPC=
RIDEAUDIT_PLAY_INTEGRITY=
RIDEAUDIT_TLS_CERT_PATH=

# ngrok is not configured in this compose env. The operator token lives at
# ~/.creds/ngrok.yml on PAYTON-LEGION2 and is copied to a non-git path on the
# tunnel host. See deploy/omarchy/ngrok/README.md. No GHCR.
