[Unit]
Description=RideAudit ngrok HTTP tunnel to admission 127.0.0.1:18080
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/ngrok http 127.0.0.1:18080 --config %h/.config/ngrok/ngrok.yml --log stdout --log-format logfmt
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
